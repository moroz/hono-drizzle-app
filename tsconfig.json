{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
    "lib": ["esnext", "esnext.temporal"],
    "rootDir": "./src",
    "paths": {
      "@schemata": ["./src/schemata/index.js"],
      "@errors": ["./src/errors/index.js"],
      "@dto": ["./src/dto/index.js"],
      "@config": ["./src/config/index.js"],
      "@services": ["./src/services/index.js"],
      "@controllers/*": ["./src/controllers/*"],
      "@db/*": ["./src/db/*"],
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules"]
}
